PORT=3000
SQLITE_PATH=./data/qiaoqiaole.sqlite
QIAOQIAOLE_USERNAME=admin
QIAOQIAOLE_PASSWORD=change-me

# Phone SMS authentication. Redis is required for phone auth; leave unset to fail closed.
REDIS_URL=redis://127.0.0.1:6379
AUTH_PHONE_PEPPER=replace-with-a-long-random-secret
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_PUBLIC_APP_ID=qiaoqiaole-h5
AUTH_ACCESS_TOKEN_TTL_SECONDS=7200
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_CAPTCHA_REQUIRED=false
AUTH_CAPTCHA_PROVIDER=tencent
VITE_TENCENT_CAPTCHA_APP_ID=

# Paste the full Cookie request header from an authenticated xiaohongshu.com browser session.
# Keep it on one line. Do not commit your real .env file.
XHS_COOKIE="a1=...; web_session=...; webId=...; webBuild=...; gid=..."

# Tencent Cloud COS. Keep the real values in .env only; never commit them.
TENCENT_COS_ENABLED=false
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_KEY_PREFIX=uploads/images
# Optional private domain used when generating signed read URLs.
# TENCENT_COS_PRIVATE_DOMAIN=cos.example.com
TENCENT_COS_PROTOCOL=https
TENCENT_COS_SIGN_EXPIRES=900

# Alibaba Cloud PNVS SMS Authentication. Never expose these values to H5 or commit real secrets.
ALIYUN_PNVS_ENABLED=false
ALIYUN_PNVS_ACCESS_KEY_ID=主账号AccessKeyID
ALIYUN_PNVS_ACCESS_KEY_SECRET=主账号AccessKeySecret
ALIYUN_PNVS_SCHEME_NAME=mini_sms_login
ALIYUN_PNVS_SIGN_NAME=恒创联众
ALIYUN_PNVS_TEMPLATE_CODE=100001
ALIYUN_PNVS_TEMPLATE_PARAM={"code":"##code##","min":"5"}
ALIYUN_PNVS_CODE_LENGTH=6
ALIYUN_PNVS_VALID_TIME_SECONDS=300
ALIYUN_PNVS_DUPLICATE_POLICY=1
ALIYUN_PNVS_INTERVAL_SECONDS=60
ALIYUN_PNVS_CODE_TYPE=1
ALIYUN_PNVS_ENDPOINT=https://dypnsapi.aliyuncs.com/
