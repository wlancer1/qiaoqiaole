PORT=3000
SQLITE_PATH=/tmp/qiaoqiaole.sqlite
QIAOQIAOLE_USERNAME=admin
QIAOQIAOLE_PASSWORD=change-me

# Paste the full Cookie request header from an authenticated xiaohongshu.com browser session.
# Keep it on one line. Do not commit your real .env file.
XHS_COOKIE="a1=...; web_session=...; webId=...; webBuild=...; gid=..."

# Tencent Cloud COS. Keep the real values in .env only; never commit them.
TENCENT_COS_ENABLED=false
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_KEY_PREFIX=uploads/images
# Optional private domain used when generating signed read URLs.
# TENCENT_COS_PRIVATE_DOMAIN=cos.example.com
TENCENT_COS_PROTOCOL=https
TENCENT_COS_SIGN_EXPIRES=900
